{
  "name": "ecommerce-tracking-guard",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-based Shopify to GA4 ecommerce measurement audit",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "type": "module"
}
